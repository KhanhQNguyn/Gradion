# Book Illustrator — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file — it contains your API key.

# ─── Gemini API ──────────────────────────────────────────────────────────────

# Your Gemini API key from https://aistudio.google.com/apikey
# Required unless GEMINI_FAKE=1 (see below).
GEMINI_API_KEY=

# Text model used for steps 2–4 (book interaction, style, characters, chapters).
# Must support the Interactions API (google-genai >= 2.10).
GEMINI_TEXT_MODEL=gemini-3.7-flash

# Image model used for step 5 (portraits and the chapter illustration).
# Default is "Nano Banana 2 Lite" — the cheapest/fastest current image model,
# a good fit for a 3-image cap (2 portraits + 1 chapter illustration).
# gemini-2.5-flash-image is the older "Nano Banana" and is being retired.
# Models: https://ai.google.dev/gemini-api/docs/models
# Rate limits: https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# API revision required by the Interactions API's REST endpoint, sent as the
# Api-Revision header. This is a moving target — check the current value at
# https://ai.google.dev/api/interactions-api before relying on the default.
GEMINI_API_REVISION=2026-05-20

# Base URL for all Gemini REST calls.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Set to 1 to run the ENTIRE pipeline — text and image both — against a local
# stub. No key needed, no quota spent. This is what every automated test and
# agent-run command uses.
GEMINI_FAKE=0

# Independent of GEMINI_FAKE. Set to 1 to mock ONLY image generation, while
# text calls (book upload, style, characters, chapters) go live against the
# real API. The spec asks for real calls to both a text and an image model,
# but the text models currently carry a free tier while the Nano Banana image
# models show "Free Tier: Not available" on Google's pricing page — this flag
# is how the app stays spec-compliant on text without requiring a
# billing-enabled key at all. When GEMINI_FAKE=1, this flag is irrelevant —
# everything is already stubbed.
GEMINI_IMAGE_FAKE=1

# ─── Server ──────────────────────────────────────────────────────────────────

# Port the backend HTTP server listens on.
PORT=3001

# Directory for per-project JSON state, uploaded book text, and generated images.
# Path is relative to the repo root.
DATA_DIR=be/data
