# Book Illustrator — environment variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file — it contains your API key.

# ─── Gemini API ──────────────────────────────────────────────────────────────

# Your Gemini API key from https://aistudio.google.com/apikey
# Required unless GEMINI_FAKE=1 (see below).
GEMINI_API_KEY=

# Text model used for steps 2–4 (style, characters, chapters).
# Must support the Interactions API (google-genai >= 2.10).
GEMINI_TEXT_MODEL=gemini-3.7-flash

# Image model used for steps 3 & 5 (portraits and chapter illustrations).
# Default is the "Nano Banana" model which has a free tier.
# Rate limits: https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Base URL for all Gemini REST calls.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Set to 1 to run the entire pipeline against a local stub server.
# When GEMINI_FAKE=1: no real API key is needed, no quota is consumed.
# Useful for development and CI. All generated images are placeholders.
GEMINI_FAKE=0

# ─── Server ──────────────────────────────────────────────────────────────────

# Port the backend HTTP server listens on.
PORT=3001

# Directory for per-project JSON state, uploaded book text, and generated images.
# Path is relative to the repo root.
DATA_DIR=be/data
